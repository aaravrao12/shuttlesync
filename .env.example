# Firebase (Spark plan). Leave blank to run fully offline in demo mode (local storage store).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_SCHOOL_ID=plano-senior

# Gate for teacher/admin/team screens. A client-side gate only: real enforcement is firestore.rules (see DECISIONS.md).
VITE_STAFF_PIN=plano

# Server only (Vercel env var). NEVER prefix with VITE_.
GEMINI_API_KEY=
# Optional model override for api/gemini.ts
GEMINI_MODEL=gemini-2.5-flash
